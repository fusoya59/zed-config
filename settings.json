// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "right",
    "sticky_scroll": true,
    "hide_gitignore": true,
    "auto_reveal_entries": true,
    "default_width": 432,
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
    "default_width": 432,
  },
  "outline_panel": {
    "dock": "right",
    "button": false,
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false,
  },
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "split",
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "codex-acp": {
      "favorite_config_option_values": {
        "reasoning_effort": ["high"],
        "model": ["gpt-5.3-codex"],
      },
      "default_config_options": {
        "reasoning_effort": "medium",
        "default_mode": "danger-full-access",
        "model": "gpt-5.3-codex",
      },
      "default_mode": "full-access",
      "type": "registry",
    },
  },
  "confirm_quit": true,
  "title_bar": {
    "show_branch_name": true,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_sign_in": false,
    "show_user_picture": false,
  },
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "file_finder": {
    "modal_max_width": "small",
  },
  "terminal": {
    "dock": "left",
    "font_family": "FiraCode Nerd Font",
    "font_size": 16,
    "line_height": "standard",
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "csharp": true,
    "dockerfile": true,
    "fastapi-snippets": true,
    "helm": true,
    "html": true,
    "lua": true,
    "python-snippets": true,
    "rainbow-csv": true,
    "sql": true,
    "terraform": true,
    "toml": true,
  },
  "languages": {
    "YAML": {
      "prettier": {
        "bracketSpacing": false,
      },
    },
    "TOML": {
      "format_on_save": "on",
      "language_servers": ["taplo"],
    },
    "Python": {
      "language_servers": ["basedpyright", "ruff", "!pyright"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.organizeImports.ruff",
        },
        {
          "code_action": "source.fixAll.ruff",
        },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "diagnosticSeverityOverrides": {
            "reportUnknownMemberType": false,
            "reportMissingTypeStubs": false,
            "reportArgumentType": false,
            "reportDeprecated": false,
            "reportUnusedCallResult": false,
            "reportAny": false,
          },
        },
      },
    },
  },
  "agent": {
    "profiles": {},
    "dock": "left",
    "tool_permissions": {
      "default": "allow",
    },
  },
  "icon_theme": "Catppuccin Mocha",
  "vim_mode": true,
  "ui_font_size": 17,
  "buffer_font_size": 16,
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_line_height": "standard",
  "agent_buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "file_scan_exclusions": [".venv", "__pycache__", ".mypy_cache", ".terraform"],
  "relative_line_numbers": "enabled",
  "preferred_line_length": 120,
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15,
  },
}
